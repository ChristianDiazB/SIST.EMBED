    {
        "id": "0b3bf509313cdb87",
        "type": "function",
        "z": "166440ccd0bdebf7",
        "name": "function 3",
        "func": "// 1. Asegurar que el payload sea un objeto JSON\nif (typeof msg.payload === \"string\") {\n    msg.payload = JSON.parse(msg.payload);\n}\n\n// 2. Recuperar el historial existente de la memoria del nodo (si no existe, inicia vacío)\nvar historialHumedad = context.get('historialHumedad') || [];\n\n// 3. Obtener la hora actual en formato legible (Hora de Colombia)\nvar fecha = new Date();\nvar horaFormateada = fecha.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit', second: '2-digit' });\n\n// 4. Crear la nueva fila con los datos actuales\nvar nuevaLectura = {\n    \"Hora\": horaFormateada,\n    \"Humedad\": msg.payload.humedad.toFixed(1) + \" %\"\n};\n\n// 5. Agregar la nueva lectura al INICIO del arreglo (para que lo más nuevo salga arriba)\nhistorialHumedad.unshift(nuevaLectura);\n\n// 6. Limitar el historial a los últimos 10 registros para no saturar la pantalla\nif (historialHumedad.length > 10) {\n    historialHumedad.pop();\n}\n\n// 7. Guardar el historial actualizado en la memoria del nodo\ncontext.set('historialHumedad', historialHumedad);\n\n// 8. Enviar el arreglo completo al nodo Tabla\nmsg.payload = historialHumedad;\nreturn msg;",
