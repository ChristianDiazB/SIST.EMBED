        "name": "function 1",
        "func": "// Validar que el payload sea un objeto JSON\nif (typeof msg.payload === \"string\") {\n    msg.payload = JSON.parse(msg.payload);\n}\n\n// 1. Mensaje para el nodo superior amarillo (Set msg.payload)\nvar msgModo = { payload: msg.payload }; \n\n// 2. Humedad (Gauge)\nvar msgHumedad = { payload: msg.payload.humedad };\n\n// 3. Alarma Humedad (UI-LED) -> Enciende si está fuera de rango óptimo (<40% o >80%)\nvar msgAlarmaHum = { payload: (msg.payload.humedad < 40.0 || msg.payload.humedad > 80.0) };\n\n// 4. Temperatura (Gauge)\nvar msgTemp = { payload: msg.payload.temp };\n\n// 5. Alarma Temperatura (UI-LED) -> Alerta si supera los 35°C (ejemplo de umbral de calor)\nvar msgAlarmaTemp = { payload: (msg.payload.temp > 35.0) };\n\n// 7. Tapa Abierta/Cerrada (UI-LED) -> Enciende si la tapa está físicamente abierta\nvar msgLedTapa = { payload: msg.payload.tapa === 1 };\n\n// 8. Velocidad Bomba (Gauge)\nvar msgBomba = { payload: msg.payload.bomba };\n\n// 9. Alarma Velocidad Bomba (UI-LED) -> Enciende si la bomba está trabajando al máximo (1023)\nvar msgAlarmaBomba = { payload: (msg.payload.bomba === 1023) };\n\n// Retornamos los 9 mensajes en el orden exacto de los pines de salida de tu dibujo\nreturn [\n    msgModo,         // Pin 1 (Va al Change amarillo)\n    msgHumedad,      // Pin 2 (Humedad Gauge)\n    msgAlarmaHum,    // Pin 3 (Alarma Humedad LED)\n    msgTemp,         // Pin 4 (Temperatura Gauge)\n    msgAlarmaTemp,   // Pin 5 (Alarma Temperatura LED)\n    msgLedTapa,      // Pin 7 (Tapa abierta/cerrada LED)\n    msgBomba,        // Pin 8 (Velocidad Bomba Gauge)\n    msgAlarmaBomba   // Pin 9 (Alarma velocidad bomba LED)\n];",
