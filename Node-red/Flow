        "name": "function 5",
        "func": "if (typeof msg.payload === \"string\") {\n    msg.payload = JSON.parse(msg.payload);\n}\n\n// Validar datos\nif (\n    msg.payload.humedad === undefined ||\n    msg.payload.temp === undefined\n) {\n    return null;\n}\n\n// Recuperar historial\nvar historialAlarmas = context.get('historialAlarmas') || [];\n\n// Recuperar última alarma mostrada\nvar ultimaAlarma = context.get('ultimaAlarma') || \"\";\n\n// Hora actual\nvar fecha = new Date();\n\nvar horaFormateada = fecha.toLocaleTimeString('es-CO', {\n    hour: '2-digit',\n    minute: '2-digit',\n    second: '2-digit'\n});\n\n// Variables de alarma\nvar condicionAlarma = \"\";\nvar nivelPrioridad = \"\";\n\n// --- DETECCIÓN DE ALARMAS ---\n\nif (msg.payload.humedad <= 40) {\n\n    condicionAlarma =\n        \"Humedad Crítica Baja: Suelo seco (\" +\n        msg.payload.humedad.toFixed(1) + \"%)\";\n\n    nivelPrioridad = \"🚨 CRÍTICA\";\n}\nelse if (msg.payload.humedad >= 80) {\n\n    condicionAlarma =\n        \"Humedad Crítica Alta: Suelo saturado (\" +\n        msg.payload.humedad.toFixed(1) + \"%)\";\n\n    nivelPrioridad = \"⚠️ ADVERTENCIA\";\n}\nelse if (msg.payload.temp >= 35) {\n\n    condicionAlarma =\n        \"Temperatura Alta: Estrés térmico (\" +\n        msg.payload.temp.toFixed(1) + \"°C)\";\n\n    nivelPrioridad = \"🚨 CRÍTICA\";\n}\nelse if (msg.payload.temp <= 15) {\n\n    condicionAlarma =\n        \"Temperatura Baja: Riesgo de helada (\" +\n        msg.payload.temp.toFixed(1) + \"°C)\";\n\n    nivelPrioridad = \"⚠️ MODERADA\";\n}\nelse {\n\n    // NO hay alarma\n    context.set('ultimaAlarma', \"\");\n\n    return null;\n}\n\n// --- EVITAR REPETICIÓN ---\n\nif (condicionAlarma === ultimaAlarma) {\n    return null;\n}\n\n// Guardar nueva alarma\ncontext.set('ultimaAlarma', condicionAlarma);\n\n// Crear registro\nvar nuevaAlarma = {\n    \"Hora\": horaFormateada,\n    \"Evento\": condicionAlarma,\n    \"Prioridad\": nivelPrioridad\n};\n\n// Agregar al historial\nhistorialAlarmas.unshift(nuevaAlarma);\n\n// Limitar tamaño\nif (historialAlarmas.length > 10) {\n    historialAlarmas.pop();\n}\n\n// Guardar historial\ncontext.set('historialAlarmas', historialAlarmas);\n\n// Mensajes de salida\nvar msgTabla = {\n    payload: historialAlarmas\n};\n\nvar msgNotificacion = {\n    payload: nivelPrioridad + \" - \" + condicionAlarma\n};\n\nreturn [msgTabla, msgNotificacion];",
